# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Widget Preview related
.widget_preview/

# Release signing: never commit keystores or their passwords
*.jks
*.keystore
key.properties
# Play App Signing exports (upload certificate, PEPK-encrypted key)
*.pem
*.p12
*.pepk
*.der
.env
.env.*

# Release artifacts copied out of build/ (sideloading, uploads)
*.apk
*.aab

# Files pulled from a test phone: reports, data exports, database copies.
# These can hold health data, so they must never be committed.
symptom-report-*.pdf
journal-export-*.json
*.db
*.db-wal
*.db-shm
*.sqlite

# Claude Code per-user settings
.claude/settings.local.json

# Private planning and handoff docs (kept locally, never published)
/dev/
/AGENTS.md
/CLAUDE.md
