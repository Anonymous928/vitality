<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: never copy app data to Google cloud backup or to a new
     device. The DB key lives in the Keystore and isn't transferable anyway;
     users move data with the passphrase-encrypted export. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
