  "fixed_sql": [
    {
      "name": "episodes",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"episodes\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"occurred_at\" INTEGER NOT NULL, \"type\" INTEGER NOT NULL, \"sleep_quality\" INTEGER NULL, \"alcohol\" INTEGER NULL CHECK (\"alcohol\" IN (0, 1)), \"stress\" INTEGER NULL, \"pre_interventions\" TEXT NOT NULL DEFAULT '[]', \"note\" TEXT NULL, \"recovered_at\" INTEGER NULL, \"recovery_pct\" INTEGER NULL, \"peak_severity\" INTEGER NULL, \"check_in_count\" INTEGER NOT NULL DEFAULT 0);"
        }
      ]
    },
    {
      "name": "check_ins",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"check_ins\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"episode_id\" INTEGER NOT NULL REFERENCES episodes (id) ON DELETE CASCADE, \"at\" INTEGER NOT NULL, \"overall\" INTEGER NOT NULL, \"symptom_scores\" TEXT NOT NULL DEFAULT '{}', \"severity\" INTEGER NOT NULL, \"note\" TEXT NULL);"
        }
      ]
    },
    {
      "name": "daily_summaries",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"daily_summaries\" (\"day\" INTEGER NOT NULL, \"max_severity\" INTEGER NULL, \"active_episode_id\" INTEGER NULL, \"check_in_count\" INTEGER NOT NULL DEFAULT 0, PRIMARY KEY (\"day\"));"
        }
      ]
    },
    {
      "name": "treatments",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"treatments\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"name\" TEXT NOT NULL, \"treatment_class\" TEXT NULL, \"dose\" TEXT NULL, \"prescriber\" TEXT NULL, \"started_at\" INTEGER NULL, \"ended_at\" INTEGER NULL);"
        }
      ]
    },
    {
      "name": "assessments",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"assessments\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"date\" INTEGER NOT NULL, \"waldinger_answers\" TEXT NOT NULL, \"onset_type\" TEXT NULL);"
        }
      ]
    },
    {
      "name": "settings",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"settings\" (\"key\" TEXT NOT NULL, \"value\" TEXT NOT NULL, PRIMARY KEY (\"key\"));"
        }
      ]
    }
  ]
